# .env.example
# Safe template file committed to git.
# Copy this file to .env.local and fill in real secrets for local development:
#   cp .env.example .env.local

# -------------------------------------------------------------
# Server-Only Secrets (Never prefix with NEXT_PUBLIC_)
# -------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Internal Backend / Microservice API Secret Key
API_SECRET_KEY=sk_test_your_internal_api_key_here

# JSON Web Token Secret for authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe Secret Key for server-side payment processing
STRIPE_SECRET_KEY=sk_test_stripe_secret_key_here

# -------------------------------------------------------------
# Public Client Variables (Safe to expose to the browser)
# -------------------------------------------------------------

# Base public API endpoint
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Application Display Name
NEXT_PUBLIC_APP_NAME=DynamicRoutes App

# Stripe Publishable Key for client-side elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_stripe_publishable_key_here

# Google Analytics / Telemetry Measurement ID
NEXT_PUBLIC_ANALYTICS_ID=GA-123456789
